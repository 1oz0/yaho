# =============================================================================
# 야호(Yaho) 백엔드 환경변수
# -----------------------------------------------------------------------------
# PowerShell 에서 이 파일을 복사하려면:
#   Copy-Item .env.example .env
#
# 부팅 시 src/config/env.validation.ts 가 아래 값을 전부 검증한다.
# 하나라도 잘못되면 서버가 뜨지 않고 즉시 실패한다 (발표 당일 조용한 오작동 방지).
# =============================================================================

# --- 실행 환경 ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- 데이터베이스 -------------------------------------------------------------
# ⚠️ DB 를 바꿀 때는 이 값만 바꾸지 말고 반드시 전환 스크립트를 함께 실행할 것.
#      npm run db:use:sqlite     →  DATABASE_URL="file:./dev.db"
#      npm run db:use:postgres   →  DATABASE_URL="postgresql://..."
#
# [기본] SQLite — 별도 설치 없이 즉시 구동. 발표 당일 오프라인 대비 경로.
DATABASE_URL="file:./dev.db"
#
# [대안] PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yaho?schema=public"

# --- 인증 ---------------------------------------------------------------------
# 운영이라면 반드시 교체할 것. 32자 이상.
JWT_SECRET="yaho-hackathon-demo-secret-change-me-please"
JWT_EXPIRES_IN="7d"

# --- 데모 계정 (시드가 이 값으로 계정을 만든다) --------------------------------
DEMO_USER_EMAIL="demo@yaho.kr"
DEMO_USER_PASSWORD="yaho1234"

# --- 가상 금융 프로바이더 ------------------------------------------------------
# 실제 금융 API 처럼 보이도록 넣는 인위적 지연(ms). 0 이면 지연 없음.
# 발표 때 로딩 애니메이션이 자연스러워진다.
MOCK_LATENCY_MIN_MS=150
MOCK_LATENCY_MAX_MS=400

# 모든 mock 기관의 공통 로그인 비밀번호 (시드가 해시해 저장)
MOCK_PROVIDER_PASSWORD="1234"

# --- 데모 모드 -----------------------------------------------------------------
# true 일 때만 /api/v1/demo/* 라우트가 등록된다. 발표에서는 반드시 true.
DEMO_MODE=true

# --- Swagger --------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Claude API (AI 여행코스 생성) -----------------------------------------------
# ⚠️ 실제 키는 .env 에만 넣는다. 이 파일(.env.example)은 커밋되므로 절대 채우지 말 것.
#
# 키가 비어 있어도 서버는 정상 기동한다. 이때 AI 코스 API 는 시드 루트를 재구성한
# 폴백을 내려주고 `generatedBy: "FALLBACK"` 으로 표시한다.
# 즉 발표 당일 네트워크가 끊겨도 여행코스 화면은 비지 않는다.
ANTHROPIC_API_KEY=

# 사용 모델. claude-opus-5 | claude-opus-4-8 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# 추론 강도. low | medium | high | xhigh | max
# 여행코스는 "정해진 후보 안에서 순서와 문구를 짜는" 중간 난이도 작업이라 medium 이 기본.
# 발표에서 응답이 느리다 싶으면 low 로 낮추면 된다.
ANTHROPIC_EFFORT=medium

# 이 시간을 넘기면 Claude 호출을 포기하고 폴백으로 전환한다 (무한 로딩 방지).
# SDK 가 429/5xx 에 대해 1회 재시도하므로 최악의 경우 이 값의 약 2배까지 걸릴 수 있다.
ANTHROPIC_TIMEOUT_MS=30000

# false 로 두면 키가 있어도 Claude 를 호출하지 않는다. 오프라인 리허설용 스위치.
AI_COURSE_ENABLED=true
