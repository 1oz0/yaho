# =============================================================================
# 야호(Yaho) 백엔드 환경변수
# -----------------------------------------------------------------------------
# PowerShell 에서 이 파일을 복사하려면:
#   Copy-Item .env.example .env
#
# 부팅 시 src/config/env.validation.ts 가 아래 값을 전부 검증한다.
# 하나라도 잘못되면 서버가 뜨지 않고 즉시 실패한다 (발표 당일 조용한 오작동 방지).
# =============================================================================

# --- 실행 환경 ---------------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- 데이터베이스 -------------------------------------------------------------
# ⚠️ DB 를 바꿀 때는 이 값만 바꾸지 말고 반드시 전환 스크립트를 함께 실행할 것.
#      npm run db:use:sqlite     →  DATABASE_URL="file:./dev.db"
#      npm run db:use:postgres   →  DATABASE_URL="postgresql://..."
#
# [기본] SQLite — 별도 설치 없이 즉시 구동. 발표 당일 오프라인 대비 경로.
DATABASE_URL="file:./dev.db"
#
# [대안] PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yaho?schema=public"

# --- 인증 ---------------------------------------------------------------------
# 운영이라면 반드시 교체할 것. 32자 이상.
JWT_SECRET="yaho-hackathon-demo-secret-change-me-please"
JWT_EXPIRES_IN="7d"

# --- 데모 계정 (시드가 이 값으로 계정을 만든다) --------------------------------
DEMO_USER_EMAIL="demo@yaho.kr"
DEMO_USER_PASSWORD="yaho1234"

# --- 가상 금융 프로바이더 ------------------------------------------------------
# 실제 금융 API 처럼 보이도록 넣는 인위적 지연(ms). 0 이면 지연 없음.
# 발표 때 로딩 애니메이션이 자연스러워진다.
MOCK_LATENCY_MIN_MS=150
MOCK_LATENCY_MAX_MS=400

# 모든 mock 기관의 공통 로그인 비밀번호 (시드가 해시해 저장)
MOCK_PROVIDER_PASSWORD="1234"

# --- 데모 모드 -----------------------------------------------------------------
# true 일 때만 /api/v1/demo/* 라우트가 등록된다. 발표에서는 반드시 true.
DEMO_MODE=true

# --- Swagger --------------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Claude API ------------------------------------------------------------------
# ⚠️ 실제 키는 .env 에만 넣는다. 이 파일(.env.example)은 커밋되므로 절대 채우지 말 것.
#
# 키가 비어 있어도 서버는 정상 기동한다. AI 를 쓰는 세 기능이 전부 규칙 기반으로
# 자동 강등될 뿐이다 — 발표 당일 네트워크가 끊겨도 모든 화면이 그대로 뜬다.
ANTHROPIC_API_KEY=

# 사용 모델. claude-opus-5 | claude-opus-4-8 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# 기본 추론 강도. low | medium | high | xhigh | max
# 여행코스·페르소나는 "여러 후보를 견주는" 판단 작업이라 medium 이 기본이다.
# (거래 분류는 지식 조회에 가까워 코드가 자체적으로 low 를 쓴다 — 이 값과 무관.)
ANTHROPIC_EFFORT=medium

# 기본 타임아웃. 넘기면 호출을 포기하고 폴백으로 전환한다 (무한 로딩 방지).
# SDK 가 429/5xx 에 대해 1회 재시도하므로 최악의 경우 이 값의 약 2배까지 걸릴 수 있다.
# (거래 분류는 이미 로딩 화면이 떠 있는 배치 작업이라 코드가 90초를 따로 쓴다.)
ANTHROPIC_TIMEOUT_MS=30000

# --- 기능별 AI 스위치 -------------------------------------------------------------
# 셋 다 독립이다. 하나를 꺼도 나머지는 그대로 Claude 를 쓴다.
# 전부 false 로 두면 키가 있어도 호출이 0회인 완전 오프라인 모드가 된다.
#
#   실측(거래 424건 기준)
#     전부 ON   동기화 13.9초 / 페르소나 6.7초
#     전부 OFF  동기화  1.1초 / 페르소나 0.05초
#   화면 구성과 응답 형태는 양쪽이 완전히 같다. 달라지는 것은 분류 정확도와 문구뿐이다.

# 여행코스를 Claude 로 생성한다. false 면 시드 루트 폴백.
AI_COURSE_ENABLED=true

# 거래 카테고리를 Claude 로 분류한다. false 면 키워드 사전·MCC 규칙 엔진만 쓴다.
AI_CLASSIFY_ENABLED=true

# 페르소나 축을 Claude 가 고른다. false 면 최다 지출·최다 건수 규칙으로 고른다.
AI_PERSONA_ENABLED=true

# AI 분류 한 번에 보낼 가맹점 수. 배치는 동시에 던지므로 크게 묶을 이유가 없다.
# 20이면 거래 424건(가맹점 70여 곳)이 배치 4개로 갈라져 각각 15초 안팎에 끝난다.
AI_CLASSIFY_BATCH_SIZE=20
