// =============================================================================
// 야호(Yaho) — Prisma Schema (PostgreSQL 기준 / 유일한 저작 원본)
// -----------------------------------------------------------------------------
// 이 파일이 스키마의 SINGLE SOURCE OF TRUTH다.
// prisma/schema.sqlite.prisma 는 scripts/use-db.ts 가 이 파일에서 datasource
// 블록만 치환해 자동 생성한다. 절대 손으로 편집하지 말 것.
//
// SQLite 호환을 위해 아래를 전부 금지한다 (프롬프트 §2-2):
//   - enum          → String 컬럼 + src/common/constants/*.ts union 타입 + @IsIn
//   - Json          → 관계 테이블로 분리
//   - 스칼라 배열    → 관계 테이블 또는 콤마 구분 문자열
//   - Decimal       → 금액은 원 단위 Int, 비율은 basis point Int (100% = 10000)
//   - @db.* 네이티브 타입
//
// 금액 필드는 전부 `~Amount` 로 끝나며 원 단위 정수다 (프롬프트 §7).
// DateTime 은 UTC 로 저장하고, 애플리케이션 레이어에서 KST(+9, DST 없음)로 계산한다.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// SECTION 1. 가상 금융 DB (mock_*)
// -----------------------------------------------------------------------------
// "진짜 금융기관 서버가 있는 것처럼" 동작하는 별도 영역.
// 서비스 도메인 테이블과 물리적으로 분리되며, FK 로도 연결하지 않는다.
// 서비스 코드는 이 테이블을 직접 조회하지 않고 FinancialProviderPort 만 거친다.
// =============================================================================

/// 금융기관 (신한카드, KB국민카드, 카카오뱅크, 토스뱅크 …)
model MockInstitution {
  id        String @id @default(cuid())
  code      String @unique // "SHINHAN_CARD"
  name      String // "신한카드"
  type      String // InstitutionType: "CARD" | "BANK"
  logoKey   String // 프론트 아이콘 키
  brandColor String // "#0046FF"
  sortOrder Int    @default(0)

  credentials MockUserCredential[]
  accounts    MockAccount[]

  @@map("mock_institution")
}

/// 기관 로그인 자격증명. 연동(POST /connections) 시 검증용. 비밀번호는 해시 저장.
model MockUserCredential {
  id            String @id @default(cuid())
  institutionId String
  loginId       String
  passwordHash  String
  ownerName     String // "김하늘" — 본인 명의 판정에 사용

  institution MockInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  accounts    MockAccount[]

  @@unique([institutionId, loginId])
  @@map("mock_user_credential")
}

/// 계좌 / 카드
model MockAccount {
  id                  String  @id @default(cuid())
  institutionId       String
  credentialId        String
  type                String // AccountType: "CARD" | "BANK"
  accountNumberMasked String // "1234-****-****-5678"
  productName         String // "신한 Deep Dream 체크"
  ownerName           String
  isOwnAccount        Boolean @default(true) // 본인 명의 여부 → 계좌 간 이체 판정
  openedAt            DateTime

  institution  MockInstitution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  credential   MockUserCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  transactions MockTransaction[]

  @@index([credentialId])
  @@map("mock_account")
}

/// 원본 거래.
/// ⚠️ 여기에는 카테고리 컬럼이 절대 없다. 실제 카드사가 주는 수준의 원시 데이터만 담는다.
///    카테고리를 미리 넣으면 분류 엔진이 무의미해진다 (프롬프트 §4-1).
model MockTransaction {
  id                String   @id @default(cuid())
  accountId         String
  approvedAt        DateTime // 승인 일시
  merchantName      String // "배민)한식대첩 광주점", "이체 김**", "카카오페이"
  amount            Int // 원 단위
  txType            String // TxType: "APPROVAL" | "CANCEL" | "TRANSFER_OUT" | "TRANSFER_IN"
  mcc               String? // 업종코드 — 약 30%는 null
  installmentMonths Int      @default(0) // 0 = 일시불
  memo              String?

  // 아래 2개는 실제 명세서에도 존재하는 필드로, 결정론적 상계·이체 판정에 필요하다.
  approvalNo     String? // 승인번호. CANCEL 행은 원거래와 동일한 승인번호를 갖는다.
  counterpartKey String? // 이체 상대 식별자(마스킹 계좌/예금주). 본인 계좌 간 이체 판정용.

  account MockAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, approvedAt])
  @@index([approvalNo])
  @@map("mock_transaction")
}

// =============================================================================
// SECTION 2. 사용자 / 연동
// =============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  ageBand      String // AgeBand: "20S_EARLY" | "20S_LATE" | "30S_EARLY" | …
  regionCode   String // 행정구역 코드. 데모 계정은 광주 "29"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connections    Connection[]
  transactions   Transaction[]
  merchantRules  UserMerchantRule[]
  personas       UserPersona[]
  savingGoals    SavingGoal[]
  challenges     Challenge[]
  badges         UserBadge[]
  issuedCoupons  IssuedCoupon[]
  aiTravelCourses AiTravelCourse[]

  @@map("app_user") // "user" 는 PostgreSQL 예약어이므로 접두사를 붙인다
}

/// 기관 연동 1건. 복수 기관 동시 연동 가능.
/// mock_institution 에 FK 를 걸지 않고 code/name 을 스냅샷으로 보관한다
/// (실제 마이데이터 API 로 교체될 때 구조 변경이 없도록).
model Connection {
  id                 String    @id @default(cuid())
  userId             String
  institutionCode    String // MockInstitution.code 논리 참조
  institutionName    String
  institutionType    String
  providerSessionKey String // 프로바이더가 발급한 세션 키
  status             String    @default("ACTIVE") // ConnectionStatus: "ACTIVE" | "REVOKED"
  connectedAt        DateTime  @default(now())
  lastSyncedAt       DateTime?
  revokedAt          DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts LinkedAccount[]

  @@unique([userId, institutionCode])
  @@index([userId, status])
  @@map("connection")
}

/// 연동으로 자동 등록된 계좌·카드
model LinkedAccount {
  id                  String  @id @default(cuid())
  connectionId        String
  providerAccountId   String // MockAccount.id 논리 참조
  type                String // "CARD" | "BANK"
  accountNumberMasked String
  productName         String
  ownerName           String
  isOwnAccount        Boolean @default(true)

  connection   Connection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([connectionId, providerAccountId])
  @@map("linked_account")
}

// =============================================================================
// SECTION 3. 거래 + 분류
// =============================================================================

/// 서비스로 수집된 거래. 분류 결과가 여기 붙는다.
model Transaction {
  id              String @id @default(cuid())
  userId          String
  linkedAccountId String
  providerTxId    String // MockTransaction.id — 재동기화 시 중복 방지 키

  // --- 프로바이더 원본 (읽기 전용 스냅샷) ---
  approvedAt        DateTime
  merchantName      String
  amount            Int
  txType            String
  mcc               String?
  installmentMonths Int      @default(0)
  memo              String?
  approvalNo        String?
  counterpartKey    String?

  // --- 분류 결과 ---
  normalizedMerchant String // normalizer.ts 출력
  category           String // TxCategory: FOOD_DELIVERY | DINING | … | UNCLASSIFIED | EXCLUDED
  classifiedBy       String // ClassifiedBy: TX_TYPE_GUARD | USER_RULE | GLOBAL_RULE | MCC | RECURRING | INTERNAL_TRANSFER | NONE | MANUAL
  matchedRuleId      String? // MerchantRule.id 또는 MccMapping.id
  isRecurring        Boolean @default(false)
  needsReview        Boolean @default(false) // UNCLASSIFIED 이면서 사용자 확인 대기
  excludeReason      String? // ExcludeReason: TRANSFER_IN | INTERNAL_TRANSFER | CANCELED_ORIGIN | CANCEL_ENTRY
  reviewedAt         DateTime?

  isSimulated Boolean  @default(false) // POST /demo/simulate-spending 주입분
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAccount LinkedAccount @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, providerTxId])
  @@index([userId, approvedAt])
  @@index([userId, category, approvedAt])
  @@index([userId, needsReview])
  @@index([userId, normalizedMerchant])
  @@map("transaction")
}

/// 사용자가 직접 지정한 가맹점 규칙. 분류 파이프라인 2순위 + 다음 동기화부터 자동 적용.
model UserMerchantRule {
  id                 String   @id @default(cuid())
  userId             String
  normalizedMerchant String
  category           String
  hitCount           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedMerchant])
  @@map("user_merchant_rule")
}

/// 전역 키워드 사전 (시드 ~200행). 분류 파이프라인 3순위.
model MerchantRule {
  id       String @id @default(cuid())
  pattern  String // 정규화된 부분문자열. 예: "배달의민족"
  category String
  priority Int    @default(100) // 낮을수록 먼저 평가
  label    String? // 관리용 설명

  @@unique([pattern])
  @@index([priority])
  @@map("merchant_rule")
}

/// MCC(업종코드) → 카테고리. 분류 파이프라인 4순위.
model MccMapping {
  id       String @id @default(cuid())
  mcc      String @unique
  category String
  label    String

  @@map("mcc_mapping")
}

// =============================================================================
// SECTION 4. 분석 / 페르소나
// =============================================================================

/// 연령대별 월평균 지출 기준값. 페르소나 소비량 축(LOW/NORMAL/OVER) 판정 기준.
/// scope = "TOTAL" 또는 개별 카테고리 코드.
model SpendingBenchmark {
  id               String @id @default(cuid())
  ageBand          String
  scope            String @default("TOTAL")
  monthlyAvgAmount Int
  source           String // "통계청 가계동향조사(가공)" 등 출처 표기

  @@unique([ageBand, scope])
  @@map("spending_benchmark")
}

/// 페르소나 카탈로그 48행 = 4(시간대) × 12(카테고리).
/// `페르소나 완성.xlsx` 확정안. 계산은 코드로, 표시 문구는 이 테이블에서 가져온다.
///
/// 소비량 축(LOW/NORMAL/OVER)은 페르소나 정체성에서 빠졌다.
/// "또래 대비 과소비" 진단은 여전히 유용하므로 UserPersona.spendingLevel 에 근거로만 남긴다.
model Persona {
  id          String @id @default(cuid())
  code        String @unique // "NIGHT_DELIVERY_FOOD"
  timeBand    String // MORNING | LUNCH | EVENING | NIGHT
  category    String // PersonaCategory 12종 (src/common/constants/persona-category.ts)
  displayName String // "야식 배달 러버"
  tagline     String // 한 줄 요약
  description String // 2~3문장 설명
  iconKey     String

  userPersonas UserPersona[]

  @@unique([timeBand, category])
  @@map("persona")
}

/// 사용자별 페르소나 산출 이력. 산출 근거 수치를 함께 스냅샷한다.
model UserPersona {
  id        String   @id @default(cuid())
  userId    String
  personaId String

  timeBand              String
  /// LOW | NORMAL | OVER — 페르소나 코드에는 들어가지 않고 "과소비 진단" 근거로만 쓴다
  spendingLevel         String
  /// PersonaCategory 12종 중 하나
  topCategory           String
  topCategoryAmount     Int // 월평균
  actualMonthlyAvgAmount Int // 전체 월평균 지출
  benchmarkAmount       Int
  spendingRatioBp       Int // 실지출/벤치마크. 100% = 10000 (Decimal 금지)
  monthsCovered         Int

  // 산출 근거 스냅샷.
  // 이 테이블은 "산출 시점의 사실"을 보존하는 자리다. 재조회할 때 다시 계산하면
  // 그 사이 거래가 바뀌어 화면에 보여줬던 숫자와 달라지므로, 응답에 필요한 값은 전부 저장한다.
  topTimeBandTxCount    Int      @default(0) // 최다 시간대의 승인 건수
  fallbackApplied       Boolean  @default(false) // 최다 카테고리가 축에 없어 대체했는가
  actualTopCategory     String? // 대체했다면 원래 1위였던 카테고리

  isCurrent             Boolean  @default(true)
  evaluatedAt           DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  persona Persona @relation(fields: [personaId], references: [id])

  @@index([userId, isCurrent])
  @@index([userId, evaluatedAt])
  @@map("user_persona")
}

// =============================================================================
// SECTION 5. 절약 목표 / 챌린지
// =============================================================================

/// 카테고리별 절약 희망액 묶음. totalTargetAmount = T (4주 기준액).
/// 절약 목표 = **"정해진 목표액을 카테고리에 어떻게 나눌지"** (§12-2).
///
/// 예전에는 이게 "얼마를 모을지 정하는" 곳이었지만, 이제 목표액은 여행지가 정한다.
/// 그래서 절약 목표는 항상 **특정 여행지에 종속**된다 — 여행지를 바꾸면 배분도 새로 한다.
model SavingGoal {
  id                String   @id @default(cuid())
  userId            String
  /// 이 배분이 향하는 여행지. 목표액과 기간이 여기서 나온다.
  destinationId     String
  /// 여행지의 challengeWeeks 스냅샷. 여행지 데이터가 바뀌어도 진행 중 목표는 흔들리지 않는다.
  weeks             Int
  /// 카테고리별 목표액 합계. **기간 전체 금액**이며 여행지 targetSavingAmount 와 같아야 한다.
  totalTargetAmount Int
  status            String   @default("ACTIVE") // SavingGoalStatus: ACTIVE | ARCHIVED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination TravelDestination @relation(fields: [destinationId], references: [id])
  items       SavingGoalItem[]
  challenges  Challenge[]

  @@index([userId, status])
  @@map("saving_goal")
}

model SavingGoalItem {
  id               String @id @default(cuid())
  savingGoalId     String
  category         String
  targetAmount     Int // 절약 희망액 (≤ monthlyAvgAmount)
  monthlyAvgAmount Int // 산정 시점 월평균 스냅샷 (슬라이더 최대값)

  savingGoal SavingGoal @relation(fields: [savingGoalId], references: [id], onDelete: Cascade)

  @@unique([savingGoalId, category])
  @@map("saving_goal_item")
}

/// 진행 중/완료된 챌린지
model Challenge {
  id           String @id @default(cuid())
  userId       String
  savingGoalId String
  /// 목적지. 목표액과 기간이 여기서 나왔다 (§12-2).
  destinationId String

  planType            String // PlanType: SHORT(2주) | STANDARD(4주) | LONG(8주)
  weeks               Int
  targetSavingAmount  Int
  difficulty          String // Difficulty: EASY | NORMAL | HARD
  reductionRateBp     Int // 목표액/기간예상지출. 100% = 10000

  baselineMonthlyTotalAmount Int // 산정 시점 월평균 총지출 스냅샷
  expectedSpendAmount        Int // 기간 예상 지출

  startedAt   DateTime
  endsAt      DateTime
  status      String    @default("IN_PROGRESS") // ChallengeStatus: IN_PROGRESS | SUCCEEDED | FAILED | ABANDONED
  completedAt DateTime?

  finalSavedAmount  Int? // 종료 시 확정 절약액 (음수 가능)
  finalProgressBp   Int? // 종료 시 진척률. 100% = 10000

  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingGoal    SavingGoal                @relation(fields: [savingGoalId], references: [id])
  destination   TravelDestination         @relation(fields: [destinationId], references: [id])
  categoryBudgets ChallengeCategoryBudget[]
  weeklyPlans   ChallengeWeek[]
  checkIns      ChallengeCheckIn[]
  userBadges    UserBadge[]
  issuedCoupons IssuedCoupon[]

  @@index([userId, status])
  @@map("challenge")
}

/// 챌린지 기간 전체의 카테고리별 예산
model ChallengeCategoryBudget {
  id                 String @id @default(cuid())
  challengeId        String
  category           String
  monthlyAvgAmount   Int // 기준 월평균
  targetSavingAmount Int // 기간 환산 절약 목표
  periodBudgetAmount Int // (월평균 - 절약목표) ÷ 4.345 × 주수, 원 단위 반올림

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, category])
  @@map("challenge_category_budget")
}

/// 주차 단위 계획. budgetAmount 는 해당 주 전체 예산.
model ChallengeWeek {
  id          String   @id @default(cuid())
  challengeId String
  weekNo      Int // 1-base
  startsAt    DateTime
  endsAt      DateTime
  budgetAmount Int

  challenge       Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  categoryBudgets ChallengeWeekBudget[]

  @@unique([challengeId, weekNo])
  @@map("challenge_week")
}

/// 주차 × 카테고리 예산. 반올림 잔액은 마지막 주에 몰아넣어 합계가 정확히 맞는다 (§6-3).
model ChallengeWeekBudget {
  id              String @id @default(cuid())
  challengeWeekId String
  category        String
  budgetAmount    Int

  challengeWeek ChallengeWeek @relation(fields: [challengeWeekId], references: [id], onDelete: Cascade)

  @@unique([challengeWeekId, category])
  @@map("challenge_week_budget")
}

model ChallengeCheckIn {
  id           String   @id @default(cuid())
  challengeId  String
  weekNo       Int
  checkedAt    DateTime @default(now())
  budgetAmount Int // 스냅샷
  spentAmount  Int
  savedAmount  Int // budget - spent, 음수 가능
  note         String?

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, weekNo])
  @@map("challenge_check_in")
}

// =============================================================================
// SECTION 6. 여행 처방
// =============================================================================

/// 호남권(광주·전남·전북) 인구소멸위험지역 여행지.
/// 추후 실제 소멸위험지수 데이터로 교체 가능하도록 regionCode / index 컬럼을 둔다.
model TravelDestination {
  id       String @id @default(cuid())
  code     String @unique // "GANGJIN"
  name     String // "강진"
  province String // "전라남도"
  regionCode String // 행정표준코드 "46810"

  extinctionRiskIndexBp Int // 소멸위험지수 × 10000 (0.2 → 2000). Decimal 금지
  riskGrade             String // "소멸고위험" | "소멸위험진입" | "소멸주의"

  /// 여행지 자체를 설명하는 문구. "다산이 18년을 머문 남도의 서재"
  tagline        String
  /// S10 처방 카드의 한 줄 카피. tagline 과 달리 **절약과 여행을 잇는 말**이다.
  /// "지친 위장과 지갑에 휴식을" — 무엇을 줄여 무엇을 얻는지가 드러나야 한다.
  catchphrase    String @default("")
  summary        String
  description    String
  heroImageUrl   String

  /// 이 여행지의 챌린지 기간(주). 2 | 4 | 8. 여행지가 기간을 정한다 (§12-2).
  challengeWeeks Int @default(4)

  /// 이 여행지에 가기 위해 모아야 하는 금액 = 챌린지 목표액 = 예상 여행 경비.
  ///
  /// 예전 `minBudgetAmount`("최소 예산")를 대체한다. 셋을 따로 두면 S18 정산 요약의
  /// "예상 여행 경비"와 S10 카드의 "목표 60,000원"이 어긋날 수 있어 하나로 합쳤다.
  targetSavingAmount Int

  /// 광주 출발 편도 교통비(원). S18 정산 요약에서 왕복으로 2배 계산한다.
  oneWayFareAmount Int @default(0)
  /// 광주에서 편도 소요 시간(분). 지도 바텀시트의 "약 2시간" 표기에 쓴다.
  travelMinutesFromGwangju Int @default(0)

  /// 1박 2일이 기본이므로 1. 컬럼은 남겨 둔다 (2박 코스를 추가할 여지).
  recommendedNights Int @default(1)
  sortOrder      Int @default(0)

  /// 지도 탭의 여행지 마커 좌표 (WGS84). 시드가 항상 채우지만,
  /// 좌표 미확보 여행지를 추가할 수 있도록 nullable 로 둔다 —
  /// 지도 응답은 좌표가 없는 항목을 조용히 제외하는 대신 카운트로 알려준다.
  latitude  Float?
  longitude Float?

  routes  TravelRoute[]
  photos  TravelPhoto[]
  reviews TravelReview[]
  coupons Coupon[]
  aiCourses AiTravelCourse[]
  savingGoals SavingGoal[]
  challenges  Challenge[]

  @@index([targetSavingAmount])
  @@map("travel_destination")
}

/// 여행지당 정확히 2개를 시드한다 (§6-5).
model TravelRoute {
  id            String @id @default(cuid())
  destinationId String
  title         String // "강진 미식 완주 코스"
  theme         String // RouteTheme: FOOD | HEALING | ACTIVITY | HISTORY
  summary       String
  totalEstimatedAmount Int
  totalDurationMinutes Int
  sortOrder     Int    @default(0)

  destination TravelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  stops       RouteStop[]

  @@map("travel_route")
}

model RouteStop {
  id              String  @id @default(cuid())
  routeId         String
  sortOrder       Int
  placeName       String
  description     String
  stopType        String // StopType: SIGHT | MEAL | CAFE | ACTIVITY | STAY
  stayMinutes     Int
  estimatedAmount Int
  latitude        Float?
  longitude       Float?

  /// 1박 2일 처방전의 Day 구분. 1 또는 2 (§12-3).
  /// sortOrder 는 Day 를 가로지르는 전체 순번이라 Day1 마지막 다음이 Day2 첫 번째다.
  dayNumber Int @default(1)

  /// 야호 제휴 할인율 × 10000 (15% = 1500). Decimal 금지라 basis point.
  /// null 이면 제휴처가 아니다. 할인 적용 금액은 **서버가 계산**한다 (AI 가 쓰지 않는다).
  discountRateBp Int?
  /// 제휴처 표기명. discountRateBp 가 있을 때만 채운다.
  partnerName    String?

  route TravelRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sortOrder])
  @@index([routeId, dayNumber])
  @@map("route_stop")
}

/// 블러 정책: revealOrder 가 앞선 것부터 ceil(progressRate × 전체장수) 장만 공개.
model TravelPhoto {
  id            String  @id @default(cuid())
  destinationId String
  imageUrl      String
  caption       String
  revealOrder   Int

  destination TravelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, revealOrder])
  @@map("travel_photo")
}

model TravelReview {
  id             String   @id @default(cuid())
  destinationId  String
  authorNickname String
  rating         Int // 1~5
  content        String
  visitedAt      DateTime
  helpfulCount   Int      @default(0)

  destination TravelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@map("travel_review")
}

/// Claude API 가 생성한 페르소나 맞춤 여행코스 (§추가요청 1).
///
/// **캐시 테이블이다.** 같은 (사용자 · 여행지 · 페르소나) 조합은 한 번만 생성하고
/// 이후에는 저장된 것을 그대로 돌려준다. 이유가 셋 있다:
///   1. 발표 중 같은 화면을 두 번 열어도 내용이 달라지지 않는다
///   2. API 호출 비용과 지연이 반복되지 않는다
///   3. 네트워크가 끊겨도 이미 생성된 코스는 계속 보인다
///
/// 페르소나가 바뀌면 캐시 키가 달라지므로 자동으로 새로 생성된다.
model AiTravelCourse {
  id            String @id @default(cuid())
  userId        String
  destinationId String

  /// 캐시 키의 일부. 페르소나가 바뀌면 코스도 다시 짠다.
  personaCode  String
  /// 생성 시점의 기준 절약액 (원). 프롬프트에 넣은 예산 제약.
  budgetAmount Int

  title            String
  summary          String
  /// 왜 이 코스가 이 페르소나에게 맞는지 — 화면에 그대로 노출된다.
  personaFitReason String
  budgetNote       String
  /// 준비물 팁. 스칼라 배열 금지라 개행(\n) 구분 문자열로 저장한다.
  packingTips      String

  totalEstimatedAmount Int
  totalDurationMinutes Int

  /// "CLAUDE" | "FALLBACK" — 프론트가 "AI 생성" 배지를 붙일지 판단한다.
  generatedBy String
  /// 실제 사용 모델명. 폴백이면 "seed-route".
  modelName   String
  /// 폴백으로 내려간 이유 (키 없음 / 타임아웃 / 검증 실패 …). 성공이면 null.
  fallbackReason String?

  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  latencyMs    Int @default(0)

  createdAt DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination TravelDestination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  stops       AiTravelCourseStop[]

  @@unique([userId, destinationId, personaCode])
  @@index([userId])
  @@map("ai_travel_course")
}

/// AI 코스의 경유지.
///
/// `placeName` 은 **반드시 해당 여행지의 시드 RouteStop 중 하나**다.
/// 서버가 생성 결과를 검증해 목록에 없는 장소는 버린다 — 그래야 좌표를 붙일 수 있고,
/// 존재하지 않는 가게를 추천하는 사고를 막을 수 있다.
model AiTravelCourseStop {
  id        String @id @default(cuid())
  courseId  String
  sortOrder Int

  placeName   String
  stopType    String // StopType: SIGHT | MEAL | CAFE | ACTIVITY | STAY
  /// 1박 2일 처방전의 Day 구분. 1 또는 2.
  dayNumber   Int    @default(1)
  /// "10:30" 형식 KST 도착 예정 시각. Day 안에서만 단조 증가한다.
  arrivalTime String
  stayMinutes Int
  estimatedAmount Int
  /// 제휴 할인율 × 10000. 시드 RouteStop 에서 복사해 온다.
  discountRateBp Int?
  partnerName    String?
  /// 여기서 무엇을 하는지 (AI 가 쓴 문장)
  activity    String
  /// 페르소나 맞춤 한 줄 조언
  personaTip  String

  /// 시드 RouteStop 에서 복사해 온 좌표. 지도 탭이 이걸 그대로 쓴다.
  latitude  Float?
  longitude Float?

  course AiTravelCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, sortOrder])
  @@map("ai_travel_course_stop")
}

// =============================================================================
// SECTION 7. 보상 (뱃지 / 쿠폰)
// =============================================================================

/// 수집형 뱃지 카탈로그. 미보유 항목도 전부 내려주므로 카탈로그가 필요하다.
model Badge {
  id          String @id @default(cuid())
  code        String @unique // "FIRST_WIN"
  displayName String
  description String
  iconKey     String
  tier        String // BadgeTier: BRONZE | SILVER | GOLD
  sortOrder   Int    @default(0)

  rules      BadgeRule[]
  userBadges UserBadge[]

  @@map("badge")
}

/// 뱃지 지급 조건. 한 뱃지에 복수 조건(AND)을 걸 수 있다.
model BadgeRule {
  id             String  @id @default(cuid())
  badgeId        String
  ruleType       String // BadgeRuleType: FIRST_CHALLENGE_SUCCESS | CONSECUTIVE_SUCCESS | TOTAL_SAVED_AMOUNT | CATEGORY_SAVED_AMOUNT | CHALLENGE_COUNT
  thresholdValue Int     @default(1)
  category       String? // CATEGORY_SAVED_AMOUNT 일 때만 사용

  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@index([badgeId])
  @@map("badge_rule")
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  challengeId String? // 지급 트리거가 된 챌린지
  earnedAt    DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge      @relation(fields: [badgeId], references: [id])
  challenge Challenge? @relation(fields: [challengeId], references: [id])

  @@unique([userId, badgeId])
  @@map("user_badge")
}

/// 쿠폰 캠페인 카탈로그 (숙소·관광지 제휴)
model Coupon {
  id            String @id @default(cuid())
  code          String @unique // "GANGJIN_STAY_20"
  partnerName   String // "강진 다산독채펜션"
  title         String
  description   String
  destinationId String? // 여행지 연계 쿠폰이면 지정

  discountType      String // DiscountType: "RATE" | "AMOUNT"
  discountValue     Int // RATE 이면 퍼센트 정수(20), AMOUNT 이면 원 단위
  minSpendAmount    Int  @default(0)
  maxDiscountAmount Int?

  validFrom  DateTime // 캠페인 시작
  validUntil DateTime // 캠페인 종료
  validDays  Int      @default(30) // 발급 후 유효일수

  destination   TravelDestination? @relation(fields: [destinationId], references: [id])
  issuedCoupons IssuedCoupon[]

  @@map("coupon")
}

model IssuedCoupon {
  id          String    @id @default(cuid())
  userId      String
  couponId    String
  challengeId String?
  issueCode   String    @unique // 사용자에게 노출되는 고유 코드
  status      String    @default("ISSUED") // IssuedCouponStatus: ISSUED | USED | EXPIRED
  issuedAt    DateTime  @default(now())
  validFrom   DateTime
  validUntil  DateTime // min(캠페인 종료, 발급일 + validDays)
  usedAt      DateTime?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon     @relation(fields: [couponId], references: [id])
  challenge Challenge? @relation(fields: [challengeId], references: [id])

  @@index([userId, status])
  @@map("issued_coupon")
}

// =============================================================================
// SECTION 8. 데모 운영
// =============================================================================

/// 발표용 가상 시계 + 시드 앵커. 항상 id = "singleton" 인 단일 행.
/// 애플리케이션은 Date.now() 를 직접 호출하지 않고 ClockService.now() 만 쓴다.
model DemoState {
  id              String   @id @default("singleton")
  clockOffsetDays Int      @default(0) // POST /demo/fast-forward 누적값
  seededAt        DateTime // 시드 생성 시점의 KST 자정 앵커
  seedVersion     String   @default("v1")
  updatedAt       DateTime @updatedAt

  @@map("demo_state")
}
